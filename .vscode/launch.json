{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "NhamHealth API (Supabase)",
      "cwd": "nhamhealth_api",
      "request": "launch",
      "type": "java",
      "mainClass": "com.nhamhealth.nhamhealth_api.NhamhealthApiApplication",
      "args": ""
    },
    {
      "name": "NhamHealth App (Android emulator)",
      "cwd": "nhamhealth_app",
      "request": "launch",
      "type": "dart",
      "toolArgs": [
        "--dart-define-from-file=config/google_oauth.json",
        "--dart-define=API_BASE_URL=http://10.0.2.2:8080"
      ]
    },
    {
      "name": "NhamHealth App (physical phone)",
      "cwd": "nhamhealth_app",
      "request": "launch",
      "type": "dart",
      "toolArgs": [
        "--dart-define-from-file=config/google_oauth.json",
        "--dart-define=API_BASE_URL=http://172.16.130.26:8080"
      ]
    },
    {
      "name": "nhamhealth_app (profile mode)",
      "cwd": "nhamhealth_app",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "toolArgs": ["--dart-define-from-file=config/google_oauth.json"]
    },
    {
      "name": "nhamhealth_app (release mode)",
      "cwd": "nhamhealth_app",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "toolArgs": ["--dart-define-from-file=config/google_oauth.json"]
    }
  ]
}
