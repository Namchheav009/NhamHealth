    "version": "0.2.0",
    "configurations": [
        {
            "name": "nhamhealth_app",
            "cwd": "nhamhealth_app",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define-from-file=config/google_oauth.json"
            ]
        },
        {
            "name": "nhamhealth_app (profile mode)",
            "cwd": "nhamhealth_app",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "toolArgs": [
                "--dart-define-from-file=config/google_oauth.json"
            ]
        },
        {
            "name": "nhamhealth_app (release mode)",
            "cwd": "nhamhealth_app",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "toolArgs": [
                "--dart-define-from-file=config/google_oauth.json"
            ]
        }
    ]
}
