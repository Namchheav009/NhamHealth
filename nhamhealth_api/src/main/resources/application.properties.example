spring.application.name=nhamhealth_api
server.address=0.0.0.0
server.port=8080
server.compression.enabled=true
server.compression.min-response-size=1024
server.compression.mime-types=text/html,text/xml,text/plain,text/css,text/javascript,application/javascript,application/json
spring.profiles.active=${SPRING_PROFILES_ACTIVE:dev}

# Keep Tomcat session files out of the shared Windows temp directory. Spring
# Boot 4 rejects temp directories created by a different Windows identity.
server.servlet.session.store-dir=target/runtime-temp/sessions

# Authentication
app.auth.jwt.secret=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
app.auth.jwt.issuer=nhamhealth-api
app.auth.jwt.expiration=${JWT_ACCESS_TOKEN_TTL:PT15M}
app.auth.login-rate-limit.maximum-failures=${LOGIN_MAXIMUM_FAILURES:5}
app.auth.login-rate-limit.window=${LOGIN_RATE_LIMIT_WINDOW:PT10M}
app.auth.login-rate-limit.lock-duration=${LOGIN_LOCK_DURATION:PT15M}
app.auth.otp.expiration=${OTP_EXPIRATION:PT5M}
app.auth.otp.resend-cooldown=${OTP_RESEND_COOLDOWN:PT1M}
app.auth.otp.maximum-attempts=${OTP_MAXIMUM_ATTEMPTS:5}
app.auth.password-reset.token-expiration=${PASSWORD_RESET_TOKEN_TTL:PT15M}
app.auth.refresh-token.expiration=${REFRESH_TOKEN_TTL:P30D}
app.auth.google.client-id=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
app.auth.google.client-secret=YOUR_GOOGLE_CLIENT_SECRET

# Supabase admin bootstrap is opt-in and only creates an absent account.
app.seed.admin-enabled=${APP_SEED_ADMIN_ENABLED:false}
# Development seed accounts; admin credentials also apply to Supabase bootstrap.
app.seed.admin-email=admin@nhamhealth.local
app.seed.admin-password=CHANGE_THIS_ADMIN_PASSWORD
app.seed.user-email=user@nhamhealth.local
app.seed.user-password=CHANGE_THIS_USER_PASSWORD

# Upload storage
app.upload.directory=uploads
app.storage.supabase.url=https://YOUR_PROJECT_REF.supabase.co
app.storage.supabase.service-key=${APP_STORAGE_SUPABASE_SERVICE_KEY:}
app.storage.supabase.bucket=nhamhealth-images

# Google Gemini AI hosted models (primary food vision and nutrition engine)
app.ai.gemini.api-key=${APP_AI_GEMINI_API_KEY:}
app.ai.gemini.base-url=https://generativelanguage.googleapis.com/v1beta
app.ai.gemini.model=gemini-3.8-flash
app.ai.gemini.fallback-model=gemini-3.7-flash
app.ai.gemini.text-max-tokens=4096

# NVIDIA AI (secondary fallback). Keep NVIDIA_API_KEY on the server; never ship it in the mobile app.
app.ai.nvidia.api-key=${APP_AI_NVIDIA_API_KEY:}
app.ai.nvidia.base-url=https://integrate.api.nvidia.com/v1
app.ai.nvidia.model=meta/llama-3.2-11b-vision-instruct
app.ai.nvidia.fallback-vision-model=meta/muse-glimmer-30b
app.ai.nvidia.nutrition-model=nvidia/nemotron-3.5-lightning-30b-a3b
app.ai.nvidia.recommendation-model=nvidia/nemotron-3.5-lightning-30b-a3b
app.ai.nvidia.assistant-model=nvidia/nemotron-3.5-lightning-30b-a3b
app.ai.nvidia.assistant-max-tokens=2000
app.ai.nvidia.text-max-tokens=4096
app.ai.nvidia.nutrition-max-tokens=1200
app.ai.nvidia.recommendation-reasoning-budget=1024

# Food image recognition and nutrition confidence thresholds.
app.ai.prompt-version=food-drink-vision-v7
app.ai.food.confirmation-threshold=0.75
app.ai.food.candidate-margin-threshold=0.15
app.ai.food.portion-confirmation-threshold=0.70
app.ai.food.component-confirmation-threshold=0.65
app.ai.food.database-match-threshold=0.78
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=6MB

# Default to a local development database; set these values externally when you
# need to point at a real PostgreSQL/Supabase instance.
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:h2:mem:nhamhealth;MODE=PostgreSQL;DB_CLOSE_DELAY=-1}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:sa}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:}
spring.datasource.driver-class-name=${SPRING_DATASOURCE_DRIVER_CLASS_NAME:org.h2.Driver}
spring.jpa.database-platform=${SPRING_JPA_DATABASE_PLATFORM:org.hibernate.dialect.H2Dialect}
spring.flyway.schemas=${SPRING_FLYWAY_SCHEMAS:PUBLIC}
spring.flyway.default-schema=${SPRING_FLYWAY_DEFAULT_SCHEMA:PUBLIC}
spring.flyway.create-schemas=true
spring.datasource.hikari.maximum-pool-size=${SPRING_DATASOURCE_HIKARI_MAX_POOL_SIZE:5}
spring.datasource.hikari.minimum-idle=${SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE:2}
spring.datasource.hikari.idle-timeout=${SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT:60000}
spring.datasource.hikari.max-lifetime=${SPRING_DATASOURCE_HIKARI_MAX_LIFETIME:300000}
spring.datasource.hikari.keepalive-time=${SPRING_DATASOURCE_HIKARI_KEEPALIVE_TIME:120000}
spring.datasource.hikari.validation-timeout=${SPRING_DATASOURCE_HIKARI_VALIDATION_TIMEOUT:10000}
spring.datasource.hikari.connection-timeout=${SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT:120000}
spring.datasource.hikari.initialization-fail-timeout=${SPRING_DATASOURCE_HIKARI_INITIALIZATION_FAIL_TIMEOUT:120000}
spring.datasource.hikari.data-source-properties.sslmode=${SPRING_DATASOURCE_HIKARI_SSLMODE:disabled}
spring.datasource.hikari.data-source-properties.connectTimeout=${SPRING_DATASOURCE_HIKARI_CONNECT_TIMEOUT:20}
spring.datasource.hikari.data-source-properties.socketTimeout=${SPRING_DATASOURCE_HIKARI_SOCKET_TIMEOUT:90}
spring.datasource.hikari.data-source-properties.tcpKeepAlive=${SPRING_DATASOURCE_HIKARI_TCP_KEEPALIVE:true}
logging.level.com.zaxxer.hikari.pool.PoolBase=ERROR
logging.level.root=INFO
spring.jpa.properties.hibernate.default_schema=PUBLIC
spring.jpa.properties.hibernate.default_batch_fetch_size=20
# Local H2 development should let Hibernate generate the schema instead of trying to
# execute PostgreSQL-only Flyway scripts that are not valid under H2.
spring.jpa.hibernate.ddl-auto=${SPRING_JPA_HIBERNATE_DDL_AUTO:update}
spring.flyway.enabled=${SPRING_FLYWAY_ENABLED:false}
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=0
spring.flyway.connect-retries=5
spring.flyway.connect-retries-interval=10s
spring.jpa.open-in-view=false
spring.cache.type=caffeine
spring.cache.cache-names=adminDashboard,mealCategories,activeMealCategories,tags,mealTagNames,servingSizes,nutrients,foodCorrectionMatches
spring.cache.caffeine.spec=maximumSize=100,expireAfterWrite=60s

# Gmail SMTP (set GMAIL_USERNAME and GMAIL_APP_PASSWORD in your environment)
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=${GMAIL_USERNAME:}
spring.mail.password=${GMAIL_APP_PASSWORD:}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true
spring.mail.properties.mail.smtp.connectiontimeout=5000
spring.mail.properties.mail.smtp.timeout=5000
spring.mail.properties.mail.smtp.writetimeout=5000
spring.mail.default-encoding=UTF-8
app.mail.from=${GMAIL_USERNAME:}
# Firebase Cloud Messaging. Point GOOGLE_APPLICATION_CREDENTIALS to the
# downloaded service-account JSON file; never commit that private file.
nhamhealth.push.enabled=${NHAMHEALTH_PUSH_ENABLED:false}

# PlasGate SMS Gateway
app.sms.plasgate.enabled=${PLASGATE_SMS_ENABLED:true}
app.sms.plasgate.fallback-to-console=${PLASGATE_SMS_FALLBACK_TO_CONSOLE:false}
app.sms.plasgate.base-url=${PLASGATE_BASE_URL:https://cloudapi.plasgate.com}
app.sms.plasgate.private-key=${PLASGATE_PRIVATE_KEY:}
app.sms.plasgate.secret-key=${PLASGATE_SECRET_KEY:}
app.sms.plasgate.sender-id=${PLASGATE_SENDER_ID:SMS Info}
app.sms.plasgate.fallback-sender-id=${PLASGATE_FALLBACK_SENDER_ID:}
