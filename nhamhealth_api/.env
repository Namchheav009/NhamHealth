# Copy this file to .env and replace each placeholder with the values shown in
# Supabase Dashboard > Connect > Session pooler > View parameters.
# Do not add quotes around the values.
SPRING_PROFILES_ACTIVE=supabase
SUPABASE_DB_URL=jdbc:postgresql://YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Hibernate creates or updates application tables in the public schema.
JPA_DDL_AUTO=update

# Keep the application pool small when using a Supabase pooler.
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
DB_POOL_IDLE_TIMEOUT=60000
DB_POOL_MAX_LIFETIME=300000

# Authentication. Use a random secret of at least 32 characters in deployed
# environments. ISO-8601 duration PT24H means 24 hours.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ISSUER=nhamhealth-api
JWT_EXPIRATION=PT24H

# Google Cloud Console OAuth 2.0 Web application client ID (no client secret).
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
