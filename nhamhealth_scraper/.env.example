# Website to scrape
RECIPES_INDEX_URL=https://cambodiancookbook.com/recipes/

# Implemented Spring Boot endpoint. Start nhamhealth_api before importing.
SPRING_IMPORT_URL=http://localhost:8080/api/admin/meals/import-scraped

# Optional ADMIN access token. If blank, the scraper logs in with the credentials below.
SPRING_IMPORT_TOKEN=
SPRING_ADMIN_LOGIN_URL=http://localhost:8080/api/admin/auth/login
SPRING_ADMIN_EMAIL=admin@example.com
SPRING_ADMIN_PASSWORD=change-me

# Be polite to the source website.
REQUEST_DELAY_SECONDS=2
REQUEST_TIMEOUT_SECONDS=25

# Keep the image under the same limit shown by your Admin Add Meal form.
MAX_IMAGE_BYTES=5242880

# First test only a few meals.
MAX_RECIPES=5

# Google Gemini AI translation for high-accuracy Khmer culinary text
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
